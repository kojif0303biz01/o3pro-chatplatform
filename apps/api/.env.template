# API Configuration
API_KEY=your-api-key-here
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Azure OpenAI Configuration (from existing .env)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-key-here
AZURE_OPENAI_API_VERSION=2024-10-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=o3-pro

# Authentication Method (api_key or azure_ad)
AZURE_AUTH_METHOD=api_key

# Optional: Azure AD Configuration
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Cosmos DB Configuration (from existing .env.cosmos)
COSMOS_DB_ENDPOINT=https://your-cosmos.documents.azure.com:443/
COSMOS_DB_KEY=your-cosmos-key-here
COSMOS_DB_DATABASE=ChatHistory
COSMOS_DB_CONTAINER=Conversations

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development